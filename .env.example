# Copy to .env and replace every *_PASSWORD / *_API_KEY placeholder.
# These host addresses/ports are for Python services running on this computer.
MYSQL_IMAGE=mysql:8.4.11
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=agentic_rag
MYSQL_USER=agentic_rag
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=5
MYSQL_POOL_RECYCLE_SECONDS=1800
TASK_LEASE_SECONDS=120
TASK_RECOVERY_BATCH_SIZE=50
OUTBOX_BATCH_SIZE=50

REDIS_IMAGE=redis:7.4.11
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password

RABBITMQ_IMAGE=rabbitmq:4.1.8-management
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=agentic_rag
RABBITMQ_PASSWORD=replace_with_rabbitmq_password

QDRANT_IMAGE=qdrant/qdrant:v1.15.2
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=replace_with_qdrant_api_key

UPLOAD_ROOT=./uploads
MODEL_CACHE_DIR=./models
HF_ENDPOINT=https://hf-mirror.com

# Required only by Agent and Retrieval; not by infrastructure scripts.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
