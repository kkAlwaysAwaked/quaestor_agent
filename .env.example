# Copy to .env and replace every *_PASSWORD / *_API_KEY placeholder.
# These host addresses/ports are for Python services running on this computer.
MYSQL_IMAGE=mysql:8.4.11
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=agentic_rag
MYSQL_USER=agentic_rag
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=5
MYSQL_POOL_RECYCLE_SECONDS=1800
TASK_LEASE_SECONDS=120
TASK_RECOVERY_BATCH_SIZE=50
OUTBOX_BATCH_SIZE=50

REDIS_IMAGE=redis:7.4.11
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password

RABBITMQ_IMAGE=rabbitmq:4.1.8-management
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=agentic_rag
RABBITMQ_PASSWORD=replace_with_rabbitmq_password

QDRANT_IMAGE=qdrant/qdrant:v1.15.2
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=replace_with_qdrant_api_key

UPLOAD_ROOT=./uploads
MODEL_CACHE_DIR=./models
HF_ENDPOINT=https://hf-mirror.com

# Required by Agent and Retrieval llm mode; fixed retrieval baseline does not need it.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Dedicated internal service key; replace with a random secret of at least 32 bytes.
RETRIEVAL_SERVICE_SECRET=replace_with_random_32_byte_service_secret
RETRIEVAL_TOKEN_TTL_SECONDS=120
RETRIEVAL_TIMEOUT_SECONDS=60
RETRIEVAL_RUN_LEASE_SECONDS=90
RETRIEVAL_MAX_INFLIGHT=8
RETRIEVAL_PIPELINE_CONCURRENCY=2
RETRIEVAL_QDRANT_TIMEOUT_SECONDS=10
# fixed isolates LLM rewriting during retrieval baseline checks; default production mode is llm.
RETRIEVAL_QUERY_MODE=llm

# Agent Worker: independent queue process; reuse the Retrieval service above.
RETRIEVAL_BASE_URL=http://127.0.0.1:8001
AGENT_MODEL_NAME=deepseek-v4-flash
# enabled keeps reasoning only inside this attempt's model/tool protocol.
AGENT_THINKING_MODE=disabled
AGENT_CONCURRENCY=2
AGENT_PREFETCH_COUNT=2
AGENT_MAX_ATTEMPTS=3
AGENT_MAX_STEPS=5
AGENT_MODEL_MAX_TOKENS=4096
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_GENERATION_TIMEOUT_SECONDS=180
AGENT_RETRIEVAL_TIMEOUT_SECONDS=70
AGENT_MAX_OUTPUT_CHARS=20000
AGENT_SHUTDOWN_GRACE_SECONDS=20
# Keep the full active Stream; terminal expiry starts after done/error publication.
CHAT_ACTIVE_TTL_SECONDS=3600
CHAT_TERMINAL_TTL_SECONDS=86400
